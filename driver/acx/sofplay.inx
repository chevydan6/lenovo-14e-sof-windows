; SPDX-License-Identifier: GPL-2.0-only
; Experimental N100 ACX render circuit. Do not install until streaming works.

[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=10/14/2026,0.1.1.0
CatalogFile=sofplay.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
sofplay.sys=1,,

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceName%=Install,PCI\VEN_8086&DEV_54C8&SUBSYS_00000000

[Install.NT]
CopyFiles=DriverFiles

; The earlier probe package restricted this PDO to SYSTEM and Administrators.
; Grant the Windows audio services (Local Service) stream access on the
; integrated ACX package. The probe's powerful IOCTLs remain development-only.
[Install.NT.HW]
AddReg=DeviceSecurity

[DeviceSecurity]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGWGX;;;LS)"

[DriverFiles]
sofplay.sys

[Install.NT.Services]
AddService=sofplay,0x00000002,Service

[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\sofplay.sys

[Install.NT.Wdf]
KmdfService=sofplay,WdfSection

[WdfSection]
KmdfLibraryVersion=$KMDFVERSION$

[Install.NT.Interfaces]
AddInterface=%KsCategoryAudio%,%SpeakerName%,SpeakerInterface
AddInterface=%KsCategoryRender%,%SpeakerName%,SpeakerInterface
AddInterface=%KsCategoryRealtime%,%SpeakerName%,SpeakerInterface

[SpeakerInterface]
AddReg=SpeakerInterfaceReg

[SpeakerInterfaceReg]
HKR,,CLSID,,%ProxyClsid%
HKR,,FriendlyName,,%SpeakerFriendlyName%
HKR,EP\0,%EndpointAssociation%,,%NodeTypeAny%
HKR,EP\0,%EndpointEventDriven%,0x00010001,0x1
; Serialized VT_BLOB with 48 kHz stereo PCM, 24 valid bits in 32-bit slots.
HKR,EP\0,%AudioEngineOemFormat%,0x00000001,41,00,00,00,28,00,00,00,\
 FE,FF,02,00,80,BB,00,00,00,DC,05,00,08,00,20,00,16,00,18,00,\
 03,00,00,00,01,00,00,00,00,00,10,00,80,00,00,AA,00,38,9B,71

[Strings]
ProviderName="Lenovo 14e SOF Community Project"
DiskName="Lenovo 14e Gen 3 SOF speaker"
DeviceName="Lenovo 14e Gen 3 SOF speaker (development)"
ServiceName="Lenovo 14e Gen 3 SOF speaker"
SpeakerName="Speaker0"
SpeakerFriendlyName="Lenovo 14e Gen 3 SOF Speakers"
ProxyClsid="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KsCategoryAudio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KsCategoryRender="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KsCategoryRealtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
EndpointAssociation="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EndpointEventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
AudioEngineOemFormat="{E4870E26-3CC5-4CD2-BA46-CA0A9A70ED04},3"
NodeTypeAny="{00000000-0000-0000-0000-000000000000}"
